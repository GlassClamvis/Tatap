#!/bin/bash
set -e

# Resolve absolute path to AppDir
HERE="$(dirname "$(readlink -f "${0}")")"
export APPDIR="${HERE}"

# Setup runtime environment
export PATH="${HERE}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${HERE}/usr/lib:${HERE}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH}"
export PYTHONHOME="${HERE}/usr"
export PYTHONPATH="${HERE}/usr/lib/python3.11/site-packages:${HERE}/backend:${PYTHONPATH}"
export PYTHONUNBUFFERED=1

# Storage directory (writable)
DATA_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/tatap"
mkdir -p "${DATA_DIR}/cache"
export TATAP_DATABASE_PATH="${DATA_DIR}/anime.db"
export TATAP_CACHE_DIR="${DATA_DIR}/cache"

# Cleanup function on exit
cleanup() {
    if [ -n "$SERVER_PID" ]; then
        kill "$SERVER_PID" 2>/dev/null || true
        wait "$SERVER_PID" 2>/dev/null || true
    fi
}
trap cleanup EXIT INT TERM

# Clean up any stale process occupying port 8767 before startup
fuser -k 8767/tcp >/dev/null 2>&1 || true

# Start backend server
"${HERE}/usr/bin/python3" "${HERE}/backend/main.py" &
SERVER_PID=$!

# Wait for server ready (max 10 seconds) using Python internal or curl
READY=0
for i in {1..20}; do
    if "${HERE}/usr/bin/python3" -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8767/api/health', timeout=1)" >/dev/null 2>&1 || \
       (command -v curl >/dev/null 2>&1 && curl -s --max-time 1 http://127.0.0.1:8767/api/health >/dev/null 2>&1); then
        READY=1
        break
    fi
    sleep 0.5
done

if [ "$READY" -ne 1 ]; then
    echo "Gagal memulai backend Tatap."
    exit 1
fi

# Detect browser for App Mode (frameless window)
APP_URL="http://127.0.0.1:8767"
BROWSER_CMD=""

for candidate in google-chrome google-chrome-stable chromium chromium-browser brave-browser microsoft-edge; do
    if command -v "$candidate" >/dev/null 2>&1; then
        BROWSER_CMD="$candidate"
        break
    fi
done

if [ -n "$BROWSER_CMD" ]; then
    # Run in isolated application window mode
    CHROME_DATA_DIR="${DATA_DIR}/browser-profile"
    mkdir -p "$CHROME_DATA_DIR"
    "$BROWSER_CMD" --user-data-dir="$CHROME_DATA_DIR" --app="$APP_URL" --disable-http-cache --window-size=1280,720 --class=tatap >/dev/null 2>&1 &
    BROWSER_PID=$!

    # Fail-safe monitoring: check if browser process is still alive or delegated
    sleep 1.5
    if kill -0 "$BROWSER_PID" 2>/dev/null; then
        wait "$BROWSER_PID"
    else
        # Browser delegated to existing session, keep backend server alive
        wait "$SERVER_PID"
    fi
else
    # Fallback to default system browser
    if command -v xdg-open >/dev/null 2>&1; then
        xdg-open "$APP_URL" >/dev/null 2>&1 || true
    elif command -v sensible-browser >/dev/null 2>&1; then
        sensible-browser "$APP_URL" >/dev/null 2>&1 || true
    fi
    # Wait for backend process
    wait "$SERVER_PID"
fi
